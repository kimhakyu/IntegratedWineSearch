<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8EFF2"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NFC 스캔"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:id="@+id/scanIconCircle"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:background="@drawable/bg_circle_red">

            <ImageView
                android:id="@+id/ivScanIcon"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_smartphone_red"
                app:tint="@android:color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvNfcMainTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center"
            android:text="와인에 스마트폰을 가까이 대세요"
            android:textColor="#111827"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNfcDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="NFC 태그가 부착된 와인 병에 스마트폰 뒷면을 가까이 대면 자동으로 정보를 읽어옵니다."
            android:textColor="#6D7485"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvNfcStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="#D92D20"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartScan"
            android:layout_width="170dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="스캔 시작"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#D9102B"
            app:cornerRadius="16dp" />

        <LinearLayout
            android:id="@+id/layoutTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 NFC 사용 팁"
                android:textColor="#2B3345"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="5dp"
                android:text="• 스마트폰의 NFC 기능이 켜져있는지 확인하세요\n\n• 케이스를 착용한 경우 인식이 어려울 수 있습니다\n\n• 와인 병 라벨의 NFC 태그 위치에 스마트폰을 대주세요"
                android:textColor="#6D7485"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
