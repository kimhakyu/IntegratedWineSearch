<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="10dp"
    android:paddingStart="10dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#ECECF1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8F8FA"
            android:padding="18dp">

            <ImageView
                android:id="@+id/ivWine"
                android:layout_width="80dp"
                android:layout_height="108dp"
                android:background="@drawable/bg_thumb_round"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/sample_wine_red"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tvWineName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="바롤로 리제르바"
                android:textColor="#1F2430"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/ivWine"
                app:layout_constraintTop_toTopOf="@id/ivWine"
                app:layout_constraintEnd_toStartOf="@id/tvWineGrade" />

            <TextView
                android:id="@+id/tvWineGrade"
                android:layout_width="40dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_grade_badge_green"
                android:gravity="center"
                android:text="A"
                android:textColor="#1F8B4C"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/tvWineName"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvWineType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="18dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="레드 와인"
                android:textColor="#8D93A1"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/ivWine"
                app:layout_constraintTop_toBottomOf="@id/tvWineName"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvWineRegion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="이탈리아 피에몬테"
                android:textColor="#B0B5C0"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/ivWine"
                app:layout_constraintTop_toBottomOf="@id/tvWineType"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvWinePrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:text="₩180,000"
                android:textColor="#1F8B4C"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/ivWine"
                app:layout_constraintTop_toBottomOf="@id/tvWineRegion"
                app:layout_constraintEnd_toStartOf="@id/tvSearchCount"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tvSearchCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,250 검색"
                android:textColor="#B0B5C0"
                android:textSize="14sp"
                app:layout_constraintBaseline_toBaselineOf="@id/tvWinePrice"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvRank"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_rank_circle"
        android:elevation="6dp"
        android:gravity="center"
        android:text="1"

        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:translationX="4dp"
        android:translationY="4dp" />

</FrameLayout>
